[Unit]
Description=PrintJoy Backend Service
After=network.target

[Service]
User=ijas
WorkingDirectory=/home/ijas/printbot1
EnvironmentFile=/home/ijas/printbot1/.env
ExecStart=/home/ijas/printbot1/venv/bin/uvicorn web.main:app --host 0.0.0.0 --port 8000 --workers 1 --loop asyncio --log-level warning
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
