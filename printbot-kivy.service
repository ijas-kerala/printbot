[Unit]
Description=PrintJoy Kiosk Interface
After=network.target graphical.target printbot-backend.service
Wants=graphical.target
Requires=printbot-backend.service

[Service]
User=ijas
WorkingDirectory=/home/ijas/printbot1
EnvironmentFile=/home/ijas/printbot1/.env
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/ijas/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=KIVY_NO_CONSOLELOG=1
ExecStart=/home/ijas/printbot1/venv/bin/python3 kiosk/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
